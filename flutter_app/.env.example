# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# NOTE: only the Supabase URL and ANON (public) key belong here.
# The SERVICE ROLE key must NEVER appear in the Flutter app.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Base URL of the FastAPI backend.
# Used by Chrome (Flutter Web), desktop and the iOS simulator.
API_BASE_URL=http://localhost:8000/api/v1
# Android emulator cannot reach the host's "localhost" — it maps the host
# loopback to 10.0.2.2. Only used when running on Android (see api_config.dart).
API_BASE_URL_ANDROID=http://10.0.2.2:8000/api/v1
