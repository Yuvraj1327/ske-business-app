# ============================================================================
# Sai Krishna Enterprises Backend — Environment Configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================================

# --- App ---
APP_NAME="Sai Krishna Enterprises API"
APP_ENV=development                # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Supabase ---
# Project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=https://your-project.supabase.co
# Public anon key (safe to use client-side too) — used here only for JWKS/auth checks if needed
SUPABASE_ANON_KEY=your-anon-key
# Service role key — SERVER-SIDE ONLY. Never send this to Flutter.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# JWT secret for Supabase Auth (Settings -> API -> JWT Secret) used to verify tokens
SUPABASE_JWT_SECRET=your-jwt-secret

# --- Database (Postgres connection, used by SQLAlchemy) ---
# Found in Supabase: Project Settings -> Database -> Connection string.
#
# The direct host (db.<project-ref>.supabase.co) resolves to an IPv6-only
# address. That's fine for local dev on an IPv6-capable network, but hosts
# without outbound IPv6 (e.g. Railway) fail with
# "OSError: [Errno 101] Network is unreachable". On those platforms use the
# IPv4 "Session pooler" connection string instead (Project Settings ->
# Database -> Connection pooling), which uses a "postgres.<project-ref>"
# username:
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:password@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:password@db.your-project.supabase.co:5432/postgres

# --- Storage ---
SUPABASE_STORAGE_BUCKET_INVOICES=invoices
SUPABASE_STORAGE_BUCKET_IMPORTS=imports

# --- Security ---
# Used only for internal service-to-service signing, if ever needed. Not used for user auth
# (Supabase Auth owns that), but reserved for future use (e.g. signed export links).
SECRET_KEY=change-me-to-a-long-random-string

# --- Background jobs ---
# Excel import currently runs via FastAPI BackgroundTasks (see
# app/services/import_service.py) and does NOT require Redis/Celery. This
# variable is a placeholder for if you later swap in a real task queue for
# very large files or multi-worker deployments — it's read by config.py but
# nothing currently uses it.
REDIS_URL=redis://localhost:6379/0

# --- Logging ---
LOG_LEVEL=INFO
